<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0B0E11" android:fillViewport="true">

    <LinearLayout android:id="@+id/root" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/header_bg" android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="BOMA LOAD" android:textColor="#EAECEF" android:textSize="22sp"
                android:textStyle="bold" android:letterSpacing="0.08"/>
            <TextView android:id="@+id/tvBalance" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Ksh 0.00"
                android:textColor="#0ECB81" android:textSize="20sp" android:textStyle="bold"
                android:layout_marginTop="6dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="12dp">
                <TextView android:id="@+id/tvBReader" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="READER ON" android:textSize="10sp"
                    android:textColor="#0ECB81" android:background="@drawable/btn_bg" android:padding="7dp"
                    android:gravity="center" android:letterSpacing="0.1" android:layout_marginEnd="6dp"/>
                <TextView android:id="@+id/tvBMode" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="SAFE" android:textSize="10sp"
                    android:textColor="#848E9C" android:background="@drawable/btn_bg" android:padding="7dp"
                    android:gravity="center" android:letterSpacing="0.1" android:layout_marginEnd="6dp"/>
                <TextView android:id="@+id/tvBToday" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="TODAY 0 · 100%" android:textSize="10sp"
                    android:textColor="#848E9C" android:background="@drawable/btn_bg" android:padding="7dp"
                    android:gravity="center" android:letterSpacing="0.1"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/card_bg"
            android:padding="14dp" android:layout_marginTop="12dp">
            <TextView android:id="@+id/hTargets" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="TARGETS  ·  TAP TO FOLD"
                android:textColor="#848E9C" android:textSize="11sp" android:letterSpacing="0.15"/>
            <LinearLayout android:id="@+id/cTargets" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp">
                <LinearLayout android:id="@+id/llTargets" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="6dp">
                    <EditText android:id="@+id/etNewTarget" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:hint="Add target number"
                        android:inputType="phone" android:textColor="#EAECEF"
                        android:textColorHint="#4A5158" android:textSize="13sp"/>
                    <Button android:id="@+id/btnAddTarget" android:layout_width="wrap_content"
                        android:layout_height="40dp" android:text="ADD" android:textSize="12sp"
                        android:background="@drawable/btn_bg" android:textColor="#0ECB81"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/card_bg"
            android:padding="14dp" android:layout_marginTop="12dp">
            <TextView android:id="@+id/hLoad" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="LOAD VOUCHERS  ·  TAP TO FOLD"
                android:textColor="#848E9C" android:textSize="11sp" android:letterSpacing="0.15"/>
            <LinearLayout android:id="@+id/cLoad" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button android:id="@+id/btnUpload" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="44dp" android:text="UPLOAD IMAGES" android:textSize="12sp"
                        android:background="@drawable/btn_bg" android:textColor="#EAECEF" android:layout_marginEnd="6dp"/>
                    <Button android:id="@+id/btnScan" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="44dp" android:text="SCAN CARD" android:textSize="12sp"
                        android:background="@drawable/btn_bg" android:textColor="#EAECEF"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="8dp">
                    <EditText android:id="@+id/etManualPin" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:hint="16-digit PIN"
                        android:inputType="number" android:textColor="#EAECEF"
                        android:textColorHint="#4A5158" android:textSize="13sp"/>
                    <Button android:id="@+id/btnAddPin" android:layout_width="wrap_content"
                        android:layout_height="40dp" android:text="ADD" android:textSize="12sp"
                        android:background="@drawable/btn_bg" android:textColor="#0ECB81"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="PINS PER IMAGE (0 = AUTO)" android:textColor="#4A5158" android:textSize="10sp"/>
                    <EditText android:id="@+id/etExpected" android:layout_width="60dp"
                        android:layout_height="wrap_content" android:text="0" android:inputType="number"
                        android:textColor="#EAECEF" android:textSize="13sp" android:layout_marginStart="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/card_bg"
            android:padding="14dp" android:layout_marginTop="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="QUEUE  ·  TAP = REMOVE"
                android:textColor="#848E9C" android:textSize="11sp" android:letterSpacing="0.15"/>
            <LinearLayout android:id="@+id/llQueue" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp"/>
            <ProgressBar android:id="@+id/pb" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="6dp" android:max="100"
                android:progress="0" android:progressTint="#0ECB81"
                android:progressBackgroundTint="#1E2329" android:layout_marginTop="10dp"/>
            <TextView android:id="@+id/tvProgress" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0 of 0 processed"
                android:textColor="#848E9C" android:textSize="11sp" android:layout_marginTop="4dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/card_bg"
            android:padding="14dp" android:layout_marginTop="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="REVIEW  ·  KEEP OR DROP"
                android:textColor="#848E9C" android:textSize="11sp" android:letterSpacing="0.15"/>
            <TextView android:id="@+id/tvReviewCount" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="no unclear pins"
                android:textColor="#F0B90B" android:textSize="10sp" android:layout_marginTop="4dp"/>
            <LinearLayout android:id="@+id/llReview" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="6dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/card_bg"
            android:padding="14dp" android:layout_marginTop="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btnStart" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="48dp" android:text="START AUTOMATION" android:textStyle="bold"
                    android:textSize="13sp" android:background="@drawable/btn_green"
                    android:textColor="#0B0E11" android:layout_marginEnd="6dp"/>
                <Button android:id="@+id/btnStop" android:layout_width="0dp" android:layout_weight="0.35"
                    android:layout_height="48dp" android:text="STOP" android:textSize="13sp"
                    android:background="@drawable/btn_red" android:textColor="#FFFFFF"/>
            </LinearLayout>
            <Button android:id="@+id/btnRequeue" android:layout_width="match_parent"
                android:layout_height="42dp" android:text="RE-QUEUE UNLOADED" android:textSize="11sp"
                android:background="@drawable/btn_bg" android:textColor="#F0B90B" android:layout_marginTop="8dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="8dp">
                <Button android:id="@+id/btnMode" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="42dp" android:text="MODE: SAFE" android:textSize="11sp"
                    android:background="@drawable/btn_bg" android:textColor="#EAECEF" android:layout_marginEnd="6dp"/>
                <Button android:id="@+id/btnHistory" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="42dp" android:text="HISTORY" android:textSize="11sp"
                    android:background="@drawable/btn_bg" android:textColor="#EAECEF"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="8dp">
                <Button android:id="@+id/btnBalance" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="42dp" android:text="CHECK BALANCE" android:textSize="11sp"
                    android:background="@drawable/btn_bg" android:textColor="#EAECEF" android:layout_marginEnd="6dp"/>
                <Button android:id="@+id/btnUpdate" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="42dp" android:text="CHECK FOR UPDATES" android:textSize="11sp"
                    android:background="@drawable/btn_bg" android:textColor="#EAECEF"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/card_bg"
            android:padding="14dp" android:layout_marginTop="12dp">
            <TextView android:id="@+id/hTerm" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="TERMINAL  ·  TAP TO FOLD"
                android:textColor="#848E9C" android:textSize="11sp" android:letterSpacing="0.15"/>
            <ScrollView android:id="@+id/cTerm" android:layout_width="match_parent"
                android:layout_height="130dp" android:layout_marginTop="8dp" android:background="#0D1114">
                <TextView android:id="@+id/tvLog" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#0ECB81"
                    android:fontFamily="monospace" android:padding="8dp"/>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
