<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="#0B0E11">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="HISTORY" android:textColor="#EAECEF" android:textSize="22sp"
        android:textStyle="bold" android:letterSpacing="0.08"/>
    <TextView android:id="@+id/tvScore" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="TODAY: 0 loaded"
        android:textColor="#0ECB81" android:textSize="12sp" android:layout_marginTop="4dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="10dp">
        <Button android:id="@+id/bSelect" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="38dp" android:text="SELECT" android:textSize="10sp"
            android:background="@drawable/btn_bg" android:textColor="#F0B90B" android:layout_marginEnd="4dp"/>
        <Button android:id="@+id/bSelAll" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="38dp" android:text="SELECT ALL" android:textSize="10sp"
            android:background="@drawable/btn_bg" android:textColor="#F0B90B" android:visibility="gone"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp">
        <Button android:id="@+id/bAll" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="38dp" android:text="ALL" android:textSize="10sp"
            android:background="@drawable/btn_bg" android:textColor="#EAECEF" android:layout_marginEnd="4dp"/>
        <Button android:id="@+id/bOk" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="38dp" android:text="OK" android:textSize="10sp"
            android:background="@drawable/btn_bg" android:textColor="#0ECB81" android:layout_marginEnd="4dp"/>
        <Button android:id="@+id/bFail" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="38dp" android:text="FAIL" android:textSize="10sp"
            android:background="@drawable/btn_bg" android:textColor="#F6465D" android:layout_marginEnd="4dp"/>
        <Button android:id="@+id/bDead" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="38dp" android:text="DEAD" android:textSize="10sp"
            android:background="@drawable/btn_bg" android:textColor="#F0B90B" android:layout_marginEnd="4dp"/>
        <Button android:id="@+id/bVault" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="38dp" android:text="VAULT" android:textSize="10sp"
            android:background="@drawable/btn_bg" android:textColor="#848E9C"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="10dp">
        <LinearLayout android:id="@+id/llHistory" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"/>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="10dp">
        <Button android:id="@+id/bShare" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="42dp" android:text="SHARE" android:textSize="11sp"
            android:background="@drawable/btn_bg" android:textColor="#EAECEF" android:layout_marginEnd="4dp"/>
        <Button android:id="@+id/bRetry" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="42dp" android:text="RETRY FAILED" android:textSize="11sp"
            android:background="@drawable/btn_bg" android:textColor="#EAECEF" android:layout_marginEnd="4dp"/>
        <Button android:id="@+id/bClear" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="42dp" android:text="CLEAR" android:textSize="11sp"
            android:background="@drawable/btn_red" android:textColor="#FFFFFF"/>
    </LinearLayout>
    <Button android:id="@+id/bBack" android:layout_width="match_parent"
        android:layout_height="44dp" android:text="BACK" android:textSize="12sp"
        android:background="@drawable/btn_green" android:textColor="#0B0E11" android:layout_marginTop="8dp"/>
</LinearLayout>
